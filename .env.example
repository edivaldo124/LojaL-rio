# Copie para .env e preencha. Nunca versione o .env.

# desenvolvimento | producao (em produção: cookies seguros, HSTS e Mercado Pago obrigatório)
AMBIENTE=desenvolvimento

# Chave da sessão e dos tokens. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL. Local com socket: postgresql+psycopg2:///lojalirio
DATABASE_URL=postgresql+psycopg2:///lojalirio
# Banco usado pelos testes (é apagado e recriado a cada execução)
DATABASE_URL_TESTE=postgresql+psycopg2:///lojalirio_test

# Endereço público da loja (webhook do Mercado Pago, sitemap, Open Graph). Sem barra no fim.
URL_BASE=http://127.0.0.1:5000

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Token de teste começa com TEST-. Sem token, a loja usa o Pix simulado (só fora de produção).
MP_ACCESS_TOKEN=
# Segredo da assinatura do webhook (Suas integrações > Webhooks > Assinatura secreta)
MP_WEBHOOK_SECRET=
# Minutos para pagar o Pix antes de o pedido ser cancelado e o estoque devolvido
PIX_EXPIRACAO_MINUTOS=30

# Supabase Storage para as fotos (obrigatório em hospedagens com disco temporário, como o Render).
# URL: https://<ref>.supabase.co · chave: Project Settings > API Keys > Secret keys (sb_secret_...).
# Sem as duas, as fotos ficam em static/uploads/ (bom só para desenvolvimento).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=loja

# Login com Google — https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizada: {URL_BASE}/conta/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (recuperação de senha). Sem SMTP_HOST, o link vai para o log do servidor.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=nao-responda@exemplo.com

# Limite de tentativas de login. Em produção com vários workers, use Redis: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Usuário administrador criado pelo `flask seed` (sem senha, o seed gera e mostra uma)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=
